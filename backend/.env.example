PORT=5000
FRONTEND_URL=http://localhost:5001
# Generate a unique value with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=1h
MSSQL_SERVER=localhost
# Set MSSQL_INSTANCE for a named instance; otherwise use MSSQL_PORT.
MSSQL_INSTANCE=
MSSQL_PORT=1433
MSSQL_DATABASE=AI-assistant
MSSQL_USER=sa
MSSQL_PASSWORD=your_sql_server_password
MSSQL_ENCRYPT=false
MSSQL_TRUST_SERVER_CERTIFICATE=true
HF_EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
# Fine-grained Hugging Face token with "Make calls to Inference Providers" permission.
HF_TOKEN=
HF_INFERENCE_BASE_URL=https://router.huggingface.co/v1
HF_CHAT_MODEL=Qwen/Qwen3-8B:featherless-ai
TAVILY_API_KEY=
