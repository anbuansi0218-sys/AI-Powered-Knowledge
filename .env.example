MSSQL_SERVER=host.docker.internal
MSSQL_INSTANCE=
MSSQL_PORT=1433
MSSQL_DATABASE=AI-assistant
MSSQL_USER=sa
MSSQL_PASSWORD=your_sql_server_password
MSSQL_ENCRYPT=false
MSSQL_TRUST_SERVER_CERTIFICATE=true
